{"is_source_file": true, "format": "sh", "description": "This is a shell script for testing Git reftable write options. It sets environment variables, initializes repositories, and performs various tests to verify reftable packing, block sizes, restart intervals, and object index configurations.", "external_files": ["./test-lib.sh", "test-tool", "test-must-fail", "test_cmp", "test_config_global", "test_expect_success", "test_when_finished", "test_commit", "test_seq", "git", "git init", "git pack-refs", "git update-ref", "cat", "rm"], "external_methods": ["test_expect_success", "test_when_finished", "test_commit", "test_seq", "test_must_fail", "test_cmp", "test_config_global"], "published": [], "classes": [], "methods": [{"name": "init_repo", "description": "Initializes a new Git repository with initial branch 'master'."}], "calls": ["git init --initial-branch master repo", "test_commit initial", "git pack-refs", "cat >expect", "test-tool dump-reftable -b .git/reftable/*.ref", "test_cmp expect actual", "test_config_global core.logAllRefUpdates false", "test_when_finished \"rm -rf repo\"", "git update-ref --stdin", "test_seq -f \"update refs/heads/branch-%d HEAD\" 200", "test_seq -f \"update refs/heads/branch-%d HEAD\" 10", "test_must_fail git -c reftable.blockSize=50 pack-refs 2>err", "git -c reftable.blockSize=100 pack-refs", "git -c reftable.blockSize=16777216 pack-refs", "git -c reftable.restartInterval=1 pack-refs", "test_must_fail git -c reftable.restartInterval=65536 pack-refs 2>err", "git -c reftable.indexObjects=false pack-refs"], "search-terms": ["reftable", "pack-refs", "test-lib.sh", "test-tool", "block_size", "restartInterval", "indexObjects", "ref", "log", "header"], "state": 2, "file_id": 2522, "knowledge_revision": 8999, "git_revision": "5590b4e7f52017794169a93d571204141bab3d28", "hash": "5fdec12b28fdad15d10e9677cd8f3dc7", "format-version": 4, "code-base-name": "git-311190", "filename": "t/t0613-reftable-write-options.sh", "revision_history": [{"8999":