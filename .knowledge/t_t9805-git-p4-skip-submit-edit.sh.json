{"is_source_file": true, "format": "Shell script", "description": "This is a shell script that contains test cases for the 'git p4 skipSubmitEdit' feature. The script sets up a Perforce depot, runs various tests involving Git and Perforce commands, and verifies behaviors related to editing, skipping edits, and configuration options.", "external_files": ["./lib-git-p4.sh"], "external_methods": ["start_p4d", "p4", "test_expect_success", "test_when_finished", "cleanup_git", "test_line_count", "test_expect_code"], "published": [], "classes": [], "methods": [], "calls": ["start_p4d", "p4 add file1", "p4 submit -d \"change 1\"", "p4 changes //depot/...", "git p4 clone --dest=\"$git\" //depot", "git config git-p4.skipSubmitEdit true", "git config core.editor /bin/false", "git commit -a -m \"change 3\"", "git p4 submit", "git config git-p4.skipSubmitEditCheck true", "git commit -a -m \"change 4\"", "git p4 submit", "cat >ed.sh <<-EOF", "chmod 755 ed.sh", "P4EDITOR=\"\\\"$TRASH_DIRECTORY/ed.sh\\\"\"", "export P4EDITOR", "touch \"\\$1\""], "search-terms": ["skipSubmitEdit", "P4EDITOR", "lib-git-p4.sh", "start_p4d", "git p4 clone", "test_expect_success", "test_when_finished"], "state": 2, "file_id": 1692, "knowledge_revision": 8166, "git_revision": "fc1ddf42af6742fae7e770cae20e30d7902014c0", "hash": "2e85f67d8ed909092729a37942b90c35", "format-version": 4, "code-base-name": "git-311190", "filename": "t/t9805-git-p4-skip-submit-edit.sh", "revision_history": [{"8166": "fc1ddf42af6742fae7e770cae20e30d7902014c0"}]}