{"is_source_file": true, "format": "bash/shell script", "description": "This file provides shell script functions and configuration for displaying Git repository status information in the command prompt for Bash and Zsh shells. It includes functions for detecting repository state, upstream divergence, conflicts, and other status indicators, and methods for customizing prompt appearance with color and format.", "external_files": ["git", "git rev-parse", "git log", "git symbolic-ref", "git check-ignore", "git ls-files", "git diff", "git rev-list", "git config"], "external_methods": ["git config", "git rev-parse", "git log", "git symbolic-ref", "git check-ignore", "git ls-files", "git diff", "git rev-list"], "published": ["__git_ps1", "__git_ps1_colorize_gitstring"], "classes": [], "methods": ["__git_ps1", "__git_ps1_colorize_gitstring", "__git_ps1_show_upstream", "__git_eread", "__git_sequencer_status"], "calls": ["git rev-parse", "git rev-parse --git-dir --is-inside-git-dir --is-bare-repository --is-inside-work-tree --show-ref-format --short HEAD", "git config -z --get-regexp '^(svn-remote\\..*\\.url|bash\\.showupstream)$'", "git log --first-parent -1 --grep=\"^git-svn-id: \\(svn-remote\\..*\\.url\\|\\)\"", "git symbolic-ref HEAD", "git describe --contains HEAD", "git describe --tags HEAD", "git describe HEAD", "git describe --tags --exact-match HEAD", "git ls-files --unmerged", "git diff --no-ext-diff --quiet", "git diff --no-ext-diff --cached --quiet", "git rev-list --count --left-right", "git rev-list --left-right", "git check-ignore -q .", "git rev-parse --verify --quiet refs/stash", "git symbolic-ref HEAD", "git rev-parse --abbrev-ref", "git config --bool core.sparseCheckout"], "search-terms": ["git prompt support", "bash/zsh git prompt", "git repository status in prompt", "prompt customization", "shell prompt git status", "git upstream divergence", "git repository state indicators"], "state": 2, "file_id": 1278, "knowledge_revision": 7752, "git_revision": "fbcd